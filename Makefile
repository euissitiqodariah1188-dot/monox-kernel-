# MONOX Kernel - Main Makefile
# Target: ARM64 (ARMv8-A to ARMv9-A)
# Toolchain: aarch64-linux-gnu-gcc or aarch64-none-elf-gcc

# -------------------------------------------------------
# Toolchain
# -------------------------------------------------------
CROSS_COMPILE ?= aarch64-linux-gnu-
CC      := $(CROSS_COMPILE)gcc
AS      := $(CROSS_COMPILE)gcc
LD      := $(CROSS_COMPILE)ld
OBJCOPY := $(CROSS_COMPILE)objcopy
OBJDUMP := $(CROSS_COMPILE)objdump
NM      := $(CROSS_COMPILE)nm
SIZE    := $(CROSS_COMPILE)size
AR      := $(CROSS_COMPILE)ar

# -------------------------------------------------------
# Kernel version
# -------------------------------------------------------
MONOX_MAJOR := 1
MONOX_MINOR := 0
MONOX_PATCH := 0
MONOX_NAME  := "Singleblaze"

# -------------------------------------------------------
# Directories
# -------------------------------------------------------
ROOT_DIR   := $(shell pwd)
BUILD_DIR  := $(ROOT_DIR)/build
OBJ_DIR    := $(BUILD_DIR)/obj
OUT_DIR    := $(BUILD_DIR)/out

# -------------------------------------------------------
# Compiler flags
# -------------------------------------------------------
ARCH_FLAGS := \
    -march=armv8-a+crc+crypto \
    -mtune=cortex-a55 \
    -mabi=lp64 \
    -mlittle-endian

CFLAGS := \
    $(ARCH_FLAGS) \
    -std=gnu11 \
    -O2 \
    -g \
    -pipe \
    -ffreestanding \
    -fno-builtin \
    -fno-stack-protector \
    -fno-common \
    -fno-PIC \
    -fno-pie \
    -fno-omit-frame-pointer \
    -mgeneral-regs-only \
    -mstrict-align \
    -fno-tree-loop-distribute-patterns \
    -fno-jump-tables \
    -fno-tree-switch-conversion \
    -fno-delete-null-pointer-checks \
    -MMD -MP \
    -ffunction-sections \
    -fdata-sections \
    -Wall \
    -Wextra \
    -Werror=implicit-function-declaration \
    -Werror=return-type \
    -Wno-unused-parameter \
    -Wno-unused-variable \
    -Wno-sign-compare \
    -nostdinc \
    -nostdlib \
    -DMONOX_KERNEL \
    -DMONOX_VERSION_MAJOR=$(MONOX_MAJOR) \
    -DMONOX_VERSION_MINOR=$(MONOX_MINOR) \
    -DMONOX_VERSION_PATCH=$(MONOX_PATCH) \
    -I$(ROOT_DIR)/include \
    -I$(ROOT_DIR)/arch/arm64 \
    -I$(ROOT_DIR) \

ASFLAGS := \
    $(ARCH_FLAGS) \
    -D__ASSEMBLY__ \
    -I$(ROOT_DIR)/arch/arm64/boot \
    -I$(ROOT_DIR)/include \

# Raw boot-progress markers on a PL011 (works with the MMU off, no driver):
#   make clean && make EARLY_CON=0x09000000        (QEMU virt)
# prints 1 2 3 (head.S), M (MMU on) and V (running at the high address).
EARLY_CON ?=
ifneq ($(strip $(EARLY_CON)),)
CFLAGS  += -DEARLY_CON_BASE=$(EARLY_CON)
ASFLAGS += -DEARLY_CON_BASE=$(EARLY_CON)
endif

LDFLAGS := \
    -nostdlib \
    -static \
    -T $(ROOT_DIR)/arch/arm64/boot/monox.ld \
    --gc-sections \
    -Map=$(BUILD_DIR)/monox.map \
    --build-id=none \

# -------------------------------------------------------
# Source files
# -------------------------------------------------------

# Assembly sources
ASM_SRCS := \
    arch/arm64/boot/head.S \
    arch/arm64/boot/vectors.S \

# C sources
C_SRCS := \
    kernel/main.c \
    kernel/printk.c \
    kernel/dtb.c \
    lib/string.c \
    kernel/sched/sched.c \
    arch/arm64/cpu/cpu.c \
    arch/arm64/cpu/irq.c \
    arch/arm64/mm/mmu.c \
    mm/pmm.c \
    mm/kmalloc.c \
    mm/vmm.c \
    fs/vfs/vfs.c \
    fs/monoxfs/monoxfs.c \
    init/init.c \
    security/satpam/traffic_satpam.c \
    security/syscall_filter/system_satpam.c \
    drivers/gpu/gpu_driver.c \
    drivers/usb/usb.c \
    drivers/i2c/i2c.c \
    drivers/drivers_all.c \
    graphics/graphics.c \
    io/touchscreen/touchscreen.c \
    io/mouse/mouse.c \
    io/keyboard/keyboard.c \
    net/wifi/wifi.c \

# Generate object file paths
ASM_OBJS := $(patsubst %.S,$(OBJ_DIR)/%.o,$(ASM_SRCS))
C_OBJS   := $(patsubst %.c,$(OBJ_DIR)/%.o,$(C_SRCS))
ALL_OBJS := $(ASM_OBJS) $(C_OBJS)

# Header dependency tracking (generated by -MMD)
DEPS := $(C_OBJS:.o=.d)
-include $(DEPS)

# -------------------------------------------------------
# Build targets
# -------------------------------------------------------
.PHONY: all clean distclean help size run run-el2 run-debug qemu

# -------------------------------------------------------
# QEMU (aarch64 'virt'): RAM at 0x40000000, PL011 at 0x09000000.
#   -kernel takes the FLAT image (monox.img), not the ELF.
#   gic-version=3 is required: the kernel only drives a GICv3.
# -------------------------------------------------------
QEMU       ?= qemu-system-aarch64
QEMU_MEM   ?= 1G
QEMU_FLAGS ?= -M virt,gic-version=3 -cpu cortex-a57 -smp 1 -m $(QEMU_MEM) -nographic

run: all
	$(QEMU) $(QEMU_FLAGS) -kernel $(OUT_DIR)/monox.img

# boot at EL2 instead of EL1 (exercises the EL2->EL1 drop in head.S)
run-el2: all
	$(QEMU) -M virt,gic-version=3,virtualization=on -cpu cortex-a57 -smp 1 -m $(QEMU_MEM) -nographic -kernel $(OUT_DIR)/monox.img

# wait for gdb on :1234  (gdb-multiarch build/out/monox.elf -ex 'target remote :1234')
run-debug: all
	$(QEMU) $(QEMU_FLAGS) -kernel $(OUT_DIR)/monox.img -S -s

# clean rebuild WITH progress markers, then run
qemu:
	$(MAKE) clean
	$(MAKE) EARLY_CON=0x09000000 all
	$(QEMU) $(QEMU_FLAGS) -kernel $(OUT_DIR)/monox.img

all: $(OUT_DIR)/monox.elf $(OUT_DIR)/monox.img $(OUT_DIR)/monox.bin

# Final ELF
$(OUT_DIR)/monox.elf: $(ALL_OBJS) | $(OUT_DIR)
	@echo "  LD      $@"
	$(LD) $(LDFLAGS) -o $@ $(ALL_OBJS)
	$(SIZE) $@

# Raw binary image (for direct boot)
$(OUT_DIR)/monox.bin: $(OUT_DIR)/monox.elf
	@echo "  OBJCOPY $@"
	$(OBJCOPY) -O binary $< $@

# ARM64 Image (Linux boot protocol compatible)
$(OUT_DIR)/monox.img: $(OUT_DIR)/monox.bin
	@echo "  IMAGE   $@"
	cp $< $@

# Disassembly for debugging
$(OUT_DIR)/monox.lst: $(OUT_DIR)/monox.elf
	@echo "  OBJDUMP $@"
	$(OBJDUMP) -d -S $< > $@

# Symbols
$(OUT_DIR)/monox.sym: $(OUT_DIR)/monox.elf
	@echo "  NM      $@"
	$(NM) -n $< > $@

# -------------------------------------------------------
# Compile rules
# -------------------------------------------------------

# Assembly
$(OBJ_DIR)/%.o: %.S | $(OBJ_DIR)
	@mkdir -p $(dir $@)
	@echo "  AS      $<"
	$(AS) $(ASFLAGS) -c -o $@ $<

# C
$(OBJ_DIR)/%.o: %.c | $(OBJ_DIR)
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	$(CC) $(CFLAGS) -c -o $@ $<

# -------------------------------------------------------
# Directory creation
# -------------------------------------------------------
$(OBJ_DIR):
	@mkdir -p $(OBJ_DIR)

$(OUT_DIR):
	@mkdir -p $(OUT_DIR)

# -------------------------------------------------------
# Utilities
# -------------------------------------------------------
size: $(OUT_DIR)/monox.elf
	$(SIZE) -A $<

clean:
	@echo "  CLEAN"
	rm -rf $(BUILD_DIR)

distclean: clean

help:
	@echo "MONOX Kernel Build System"
	@echo ""
	@echo "Targets:"
	@echo "  all        - Build kernel (ELF + BIN + IMG)"
	@echo "  clean      - Remove build artifacts"
	@echo "  size       - Show section sizes"
	@echo ""
	@echo "Variables:"
	@echo "  CROSS_COMPILE  - Toolchain prefix (default: aarch64-linux-gnu-)"
	@echo "  ARCH_FLAGS     - Architecture flags"
	@echo ""
	@echo "Example:"
	@echo "  make CROSS_COMPILE=aarch64-none-elf-"
